#!/usr/bin/env bash
# Push main to GitHub and have PythonAnywhere deploy it, usually within ~3 minutes.
#
#     updatepa
#
# How: a free PA account gets one scheduled task.  This points that task at
# deploy.sh, moves its start time to two minutes from now, then watches
# ~/deploy.log on PA (through the PA API) until deploy.sh reports back.  The task
# also runs once a day at that time; with nothing new it only says 'already deployed'.
#
# One-time setup: create an API token on PA (Account -> API token).  The first run
# asks for it and keeps it in ~/.config/pythonanywhere/token.
set -euo pipefail

PA_USER=bnorthan
API="https://www.pythonanywhere.com/api/v0/user/$PA_USER"
TOKEN_FILE="$HOME/.config/pythonanywhere/token"
LOG="/home/$PA_USER/deploy.log"
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
TASK_CMD="(cd ~/raceresults && git pull --ff-only && . ~/.virtualenvs/raceresults/bin/activate && bash deploy.sh) > $LOG 2>&1 || echo '== deploy FAILED ==' >> $LOG"

if [ ! -s "$TOKEN_FILE" ]; then
    read -rsp "PythonAnywhere API token (Account -> API token): " token; echo
    mkdir -p "$(dirname "$TOKEN_FILE")"
    (umask 077; printf '%s\n' "$token" > "$TOKEN_FILE")
fi
TOKEN="$(cat "$TOKEN_FILE")"
api() { curl -sSf -H "Authorization: Token $TOKEN" "$@"; }
json() { python3 -c "import json, sys; d = json.load(sys.stdin); print($1)"; }

# 1. push
cd "$REPO"
if [ -n "$(git status --porcelain)" ]; then
    echo "uncommitted changes -- commit them first:"; git status --short; exit 1
fi
[ "$(git branch --show-current)" = main ] || { echo "not on main"; exit 1; }
git -c credential.helper= -c credential.helper='!gh auth git-credential' push -q origin main
sha="$(git rev-parse HEAD | cut -c1-7)"
echo "pushed $sha"

if [ "$(api "$API/files/path/home/$PA_USER/.raceresults_deployed" 2>/dev/null | cut -c1-7)" = "$sha" ]; then
    echo "$sha is already live"; exit 0
fi

# 2. deploy.sh reloads the site with the same token; give PA a copy once
api -o /dev/null "$API/files/path/home/$PA_USER/.pa_api_token" 2>/dev/null \
    || api -o /dev/null -F "content=@$TOKEN_FILE" "$API/files/path/home/$PA_USER/.pa_api_token"

# 3. clear the old log and start the task two minutes from now (PA task times are UTC)
api -o /dev/null -X DELETE "$API/files/path$LOG" 2>/dev/null || true
read -r hour minute < <(date -u -d '+2 min' '+%-H %-M')
task="$(api "$API/schedule/" | json "next((t['id'] for t in d if 'deploy.sh' in t['command']), '')")"
body=(--data-urlencode "command=$TASK_CMD" --data-urlencode enabled=true --data-urlencode interval=daily
      --data-urlencode "hour=$hour" --data-urlencode "minute=$minute"
      --data-urlencode "description=deploy raceresults (set by updatepa)")
if [ -n "$task" ]; then
    api -o /dev/null -X PATCH "${body[@]}" "$API/schedule/$task/"
else
    api -o /dev/null -X POST "${body[@]}" "$API/schedule/"
fi

# 4. wait for deploy.sh to report
printf 'PA starts the deploy at %02d:%02d UTC; waiting' "$hour" "$minute"
out=
for _ in $(seq 60); do      # 15 minutes
    sleep 15
    out="$(api "$API/files/path$LOG" 2>/dev/null || true)"
    if grep -q "== deployed $sha ==" <<< "$out"; then
        echo; grep '^== ' <<< "$out" | sed 's/^/  /'
        echo "live: https://$PA_USER.pythonanywhere.com/raceresults/"
        exit 0
    fi
    if grep -q "== deploy FAILED ==" <<< "$out"; then
        echo; echo "deploy FAILED on PA -- end of the log:"; tail -25 <<< "$out"; exit 1
    fi
    printf '.'
done
echo; echo "no result after 15 minutes -- end of the log:"; tail -25 <<< "${out:-(no log yet)}"; exit 1
