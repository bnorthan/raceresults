#!/usr/bin/env bash
# Push main to GitHub and have PythonAnywhere deploy it, usually within a few minutes.
#
#     updatepa
#
# How: free PA accounts have no scheduled tasks, but the PA API can type into a
# console.  This pushes, types the deploy into your PA Bash console, and watches
# the console until deploy.sh reports.  Keep one Bash console on PA (Consoles tab).
# PA restarts consoles now and then; if it won't take input, open it once in a
# browser and run updatepa again.
#
# One-time setup: create an API token on PA (Account -> API token).  The first run
# asks for it, keeps it in ~/.config/pythonanywhere/token, and copies it to PA as
# ~/.pa_api_token, which deploy.sh uses to reload the site.
set -euo pipefail

PA_USER=bnorthan
API="https://www.pythonanywhere.com/api/v0/user/$PA_USER"
TOKEN_FILE="$HOME/.config/pythonanywhere/token"
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

if [ ! -s "$TOKEN_FILE" ]; then
    read -rsp "PythonAnywhere API token (Account -> API token): " token; echo
    mkdir -p "$(dirname "$TOKEN_FILE")"
    (umask 077; printf '%s\n' "$token" > "$TOKEN_FILE")
fi
TOKEN="$(cat "$TOKEN_FILE")"

# api [curl args] URL: the response body, or on an HTTP error a line saying which
# call failed and PA's reason
api() {
    local out code
    out="$(curl -sS -w '\n%{http_code}' -H "Authorization: Token $TOKEN" "$@")" || return 1
    code="${out##*$'\n'}"; out="${out%$'\n'*}"
    if [ "$code" -ge 400 ]; then
        echo "PA API ${*: -1}: HTTP $code ${out:0:300}" >&2
        return 1
    fi
    printf '%s' "$out"
}
json() { python3 -c "import json, sys; d = json.load(sys.stdin); print($1)"; }

# 1. push
cd "$REPO"
if [ -n "$(git status --porcelain)" ]; then
    echo "uncommitted changes -- commit them first:"; git status --short; exit 1
fi
[ "$(git branch --show-current)" = main ] || { echo "not on main"; exit 1; }
git -c credential.helper= -c credential.helper='!gh auth git-credential' push -q origin main
sha="$(git rev-parse HEAD | cut -c1-7)"
echo "pushed $sha"

if [ "$(api "$API/files/path/home/$PA_USER/.raceresults_deployed" 2>/dev/null | cut -c1-7)" = "$sha" ]; then
    echo "$sha is already live"; exit 0
fi

# 2. deploy.sh reloads the site with the same token; give PA a copy once
api "$API/files/path/home/$PA_USER/.pa_api_token" > /dev/null 2>&1 \
    || api -F "content=@$TOKEN_FILE" "$API/files/path/home/$PA_USER/.pa_api_token" > /dev/null

# 3. type the deploy into a Bash console
console="$(api "$API/consoles/" | json "next((c['id'] for c in d if c['executable'] == 'bash'), '')")"
if [ -z "$console" ]; then
    echo "no Bash console on PA -- open one (Consoles tab -> Bash), then run updatepa again"; exit 1
fi
RUN="$(date -u +%H%M%S)"
cmd="cd ~/raceresults && workon raceresults && git pull --ff-only && bash deploy.sh; echo \"== updatepa $RUN exit \$? ==\""
if ! api --data-urlencode "input=$cmd"$'\n' "$API/consoles/$console/send_input/" > /dev/null; then
    echo "PA wouldn't take input -- open https://www.pythonanywhere.com/user/$PA_USER/consoles/$console/"
    echo "in your browser once (PA restarts consoles now and then), then run updatepa again"
    exit 1
fi

# 4. watch the console until this run reports (the typed line shows '$?', not a number)
printf 'deploying in PA console %s' "$console"
out=
for _ in $(seq 90); do      # 15 minutes
    sleep 10
    out="$(api "$API/consoles/$console/get_latest_output/" 2>/dev/null \
           | json "d.get('output', '') if isinstance(d, dict) else d" 2>/dev/null || true)"
    done_line="$(grep -oE "== updatepa $RUN exit [0-9]+ ==" <<< "$out" || true)"
    if [ -z "$done_line" ]; then
        printf '.'
        continue
    fi
    echo
    if [[ "$done_line" == *" exit 0 =="* ]] && grep -q "== deployed $sha ==" <<< "$out"; then
        echo "live: https://$PA_USER.pythonanywhere.com/raceresults/"
        exit 0
    fi
    echo "deploy didn't finish cleanly -- end of the console:"; tail -20 <<< "$out"; exit 1
done
echo; echo "no result after 15 minutes -- end of the console:"; tail -20 <<< "${out:-(nothing)}"; exit 1
